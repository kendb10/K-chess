// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// SQLite has no native enum support in Prisma, so GameResult ("WIN" | "LOSS" | "DRAW")
// and PlayerColor ("WHITE" | "BLACK") are validated at the application layer (see src/lib/types.ts).
model Game {
  id          String   @id @default(cuid())
  date        DateTime
  opponent    String
  result      String
  score       String?
  playedAs    String
  pgn         String
  timeControl String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  memos       Memo[]
}

model Memo {
  id        String   @id @default(cuid())
  gameId    String
  game      Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  ply       Int
  text      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([gameId])
}
